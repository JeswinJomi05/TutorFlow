{
  "info": {
    "_postman_id": "a8790123-bc99-4977-8d2a-7bf334a6ef20",
    "name": "TutorFlow Backend API",
    "description": "Comprehensive Postman/Thunder Client collection for TutorFlow Node/Express/MongoDB API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "tutorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Tutor Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('tutorToken', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tutor@tutorflow.com\",\n  \"password\": \"Tutor@123\",\n  \"role\": \"tutor\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "2. Student Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('studentToken', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@tutorflow.com\",\n  \"password\": \"Student@123\",\n  \"role\": \"student\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "3. Get Authenticated User (/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tutorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "4. Logout (/auth/logout)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Tutor Endpoints",
      "item": [
        {
          "name": "1. Tutor Creates Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.student) {",
                  "  pm.collectionVariables.set('studentId', json.data.student._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tutorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maya Lin\",\n  \"email\": \"maya.lin@example.com\",\n  \"password\": \"TempPass@123\",\n  \"subject\": \"Organic Chemistry\",\n  \"currentLevel\": \"College Freshman\",\n  \"learningGoals\": \"Master reaction mechanisms and synthesis\",\n  \"weakAreas\": \"Stereochemistry and Sn1/Sn2 pathways\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tutors/students",
              "host": ["{{baseUrl}}"],
              "path": ["tutors", "students"]
            }
          }
        },
        {
          "name": "2. Tutor Gets All Own Students",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tutorToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/tutors/students",
              "host": ["{{baseUrl}}"],
              "path": ["tutors", "students"]
            }
          }
        },
        {
          "name": "3. Tutor Gets Student Details By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tutorToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/tutors/students/{{studentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tutors", "students", "{{studentId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Student Endpoints",
      "item": [
        {
          "name": "1. Student Gets Own Profile (/students/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/students/me",
              "host": ["{{baseUrl}}"],
              "path": ["students", "me"]
            }
          }
        },
        {
          "name": "2. Student Gets Own Sessions (/students/sessions)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/students/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["students", "sessions"]
            }
          }
        },
        {
          "name": "3. Student Gets Assigned Homework (/students/homework)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/students/homework",
              "host": ["{{baseUrl}}"],
              "path": ["students", "homework"]
            }
          }
        }
      ]
    },
    {
      "name": "Session Endpoints & Lifecycle",
      "item": [
        {
          "name": "1. Tutor Schedules Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data._id) {",
                  "  pm.collectionVariables.set('sessionId', json.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tutorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"{{studentId}}\",\n  \"scheduledAt\": \"2026-09-10T15:00:00.000Z\",\n  \"topic\": \"Nucleophilic Substitution & Elimination Mechanisms\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["sessions"]
            }
          }
        },
        {
          "name": "2. Get Session By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tutorToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}"]
            }
          }
        },
        {
          "name": "3. Update Status: scheduled -> in_progress",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tutorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "status"]
            }
          }
        },
        {
          "name": "4. Update Notes (during in_progress)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tutorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Reviewing carbocation stability in E1 reactions.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/notes",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "notes"]
            }
          }
        },
        {
          "name": "5. Update Status: in_progress -> completed",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tutorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "status"]
            }
          }
        },
        {
          "name": "6. Update Status: completed -> ai_reviewed",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tutorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ai_reviewed\",\n  \"aiReview\": {\n    \"summary\": \"Maya showed deep comprehension of transition states.\",\n    \"homework\": [\"Complete problem set 6 on Zaitsev vs Hofmann elimination\"],\n    \"nextSessionSuggestion\": \"Alkyne addition reactions.\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "status"]
            }
          }
        }
      ]
    }
  ]
}
